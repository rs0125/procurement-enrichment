[Unit]
Description=Daily Supabase DB backup to S3
Documentation=file:///opt/warehouse-geocoder-utility/deploy/DB_BACKUP.md
Wants=network-online.target
After=network-online.target
OnFailure=warehouse-geocoder-backup-failure.service

[Service]
Type=oneshot
EnvironmentFile=/etc/warehouse-geocoder.env
ExecStart=/usr/local/sbin/warehouse-geocoder-backup
User=warehouse-enricher-backup
Group=warehouse-enricher-backup
CapabilityBoundingSet=
AmbientCapabilities=
MemoryHigh=256M
MemoryMax=384M
TasksMax=64
UMask=0077
# pg_dump + upload can run for several minutes on a non-trivial DB.
TimeoutStartSec=30min
# systemd reads the root-owned environment file before dropping privileges.
ProtectSystem=strict
ReadWritePaths=/var/backups/warehouse-geocoder
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
