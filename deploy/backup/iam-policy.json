{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListBucketScopedToPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::__BUCKET_NAME__",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["supabase/warehouse-geocoder/*"]
        }
      }
    },
    {
      "Sid": "AllowPutObjectsToBackupPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::__BUCKET_NAME__/supabase/warehouse-geocoder/*"
    }
  ]
}
