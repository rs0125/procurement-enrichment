[Unit]
Description=Warehouse Enricher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=warehouse-enricher
Group=warehouse-enricher
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
StateDirectory=warehouse-enricher
StateDirectoryMode=0750
Environment=ENRICHER_TEMP_DIR=/var/lib/warehouse-enricher/buffers
# Existing deployment paths remain compatible with the geocoder and backup jobs.
WorkingDirectory=/opt/warehouse-geocoder-utility
EnvironmentFile=/etc/warehouse-geocoder.env
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/bin/node --max-old-space-size=256 --experimental-strip-types src/index.mjs
MemoryHigh=640M
MemoryMax=768M
TasksMax=96
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
