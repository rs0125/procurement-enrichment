DATABASE_URL=postgresql://user:password@localhost:5432/wareongo
CRON_SECRET=replace-with-a-long-random-secret
PORT=3000

# Required only by the corresponding enrichment services.
OPENAI_API_KEY=
IMAGE_LABEL_MODEL=gpt-5.6-terra
MAPBOX_ACCESS_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
IMAGE_PIPELINE_CACHE_URL=

# Use a disk-backed directory; /tmp on the CRM machine is RAM-backed.
ENRICHER_TEMP_DIR=/var/tmp/warehouse-enricher

# Keep existing cron processing until the reviewed queue cutover.
# Queue mode requires PGMQ setup and a direct/session database connection.
ENRICHMENT_DELIVERY_MODE=cron
ENRICHMENT_PROCESS_ROLE=worker

# Optional, short supervised trial; omit completely for normal queue processing.
# Both arrays are required. Image IDs are registry IDs, not warehouse IDs.
# ENRICHMENT_QUEUE_TRIAL_SUBJECTS={"warehouseIds":[2748],"imageIds":[123]}
